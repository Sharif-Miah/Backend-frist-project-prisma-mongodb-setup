generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @map("_id") @default(auto()) @db.ObjectId
  name     String
  email    String @unique
  password String
  createdAt DateTime @default(now())

  resetOtp       String?
  resetOtpExpiry DateTime?

  isVerified      Boolean   @default(false)
  verifyOtp       String?
  verifyOtpExpiry DateTime?

  travelers       Traveler[]
  guestInfo       GuestInfo[]
}

type Traveler {
  travelerType       String?
  fullName           String
  dateOfBirth        String
  gender             String
  emailAddress       String?
  phoneNumber        String?
  passportNumber     String?
  passportExpiryDate String?
  country            String?
}

type GuestInfo {
  fullName        String
  emailAddress    String
  phoneNumber     String
  country         String
  specialRequests String?
}

model Flight {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  airline          String
  flightNumber     String
  departureTime    String
  arrivalTime      String
  departureAirport String
  arrivalAirport   String
  duration         String
  isDirect         Boolean  @default(true)
  price            Float
  amenities        String[]
  
  // Detailed Information
  coverImage          String?
  cabinClass          String?
  baggageAllowance    String?
  refundPolicy        String?
  dateChangePolicy    String?
  mealAvailability    String?
  includedInFare      String[]
  
  createdAt        DateTime @default(now())
}

model Destination {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  location            String
  packages            Int
  price               Float
  imageUrl            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Hotel {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  location            String
  description         String?
  pricePerNight       Float
  rating              Float    @default(0)
  coverImage          String
  images              String[]
  
  // Filtering Fields
  starRating          Int      @default(0)
  propertyType        String
  amenities           String[]
  
  // Additional Details
  checkInTime         String?
  checkOutTime        String?
  hotelPolicies       String[]
  includes            String[]
  excludes            String[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}