generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @map("_id") @default(auto()) @db.ObjectId
  name     String
  email    String @unique
  password String
  createdAt DateTime @default(now())

  resetOtp       String?
  resetOtpExpiry DateTime?

  isVerified      Boolean   @default(false)
  verifyOtp       String?
  verifyOtpExpiry DateTime?
}

model Flight {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  airline          String
  flightNumber     String
  departureTime    String
  arrivalTime      String
  departureAirport String
  arrivalAirport   String
  duration         String
  isDirect         Boolean  @default(true)
  price            Float
  amenities        String[]
  createdAt        DateTime @default(now())
}

model Destination {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  location      String
  packages      Int
  price         Float
  imageUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}